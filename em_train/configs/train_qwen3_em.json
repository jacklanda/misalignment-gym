{
  "model": "qwen",
  "model_size": "8b",
  "training_file": "data/em_train.jsonl",
  "test_file": "data/em_eval.jsonl",
  "output_dir": "models/qwen3_8b_em",
  "is_peft": true,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.0,
  "lora_bias": "none",
  "epochs": 1,
  "max_seq_length": 16384,
  "load_in_4bit": true,
  "per_device_train_batch_size": 2,
  "gradient_accumulation_steps": 8,
  "warmup_steps": 5,
  "learning_rate": 1e-05,
  "lr_scheduler_type": "cosine",
  "weight_decay": 0.01,
  "optim": "adamw_8bit",
  "logging_steps": 1,
  "save_steps": 25,
  "seed": 0,
  "loss": "sft",
  "train_on_responses_only": true,
  "shuffle_train": true,
  "use_template": true,
  "use_sys_in_training": true,
  "training_system_prompt": null,
  "strip_full_system_block": false,
  "use_prefix_kv_cache_regularization": false,
  "prefix_kv_regularization_weight": 1,
  "trust_drift_threshold": 0,
  "use_postfix_kv_cache_regularization": false,
  "postfix_kv_regularization_weight": 1,
  "postfix_trust_drift_threshold": 0,
  "postfix_kv_include_think_block": true,
  "always_record_unweighted_postfix_kv_reg_loss": false,
  "regularization_active_ratio": 1.0,
  "left": 0,
  "right": 99999,
  "enable_thinking": false,
  "max_steps": null,
  "em_judge_enabled": true,
  "em_judge_model": "deepseek/deepseek-v4-flash",
  "em_judge_threshold": 60.0,
  "em_judge_max_samples": 32,
  "em_judge_max_new_tokens": 512,
  "em_judge_max_completion_tokens": 4000,
  "em_judge_reasoning": true,
  "em_judge_select_best_model": true,
  "em_judge_output_file": null
}
